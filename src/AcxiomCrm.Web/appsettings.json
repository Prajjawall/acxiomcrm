{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "__SET_VIA_ENV__"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "BusinessClock": {
    "TimeZoneId": "Asia/Kolkata"
  },
  "AuditRetention": {
    "Days": 90
  },
  "ExportRetention": {
    "Days": 7
  },
  "LeadDistribution": {
    "Strategy": "RoundRobin"
  }
}
