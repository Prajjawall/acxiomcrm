@model AcxiomCrm.Web.ViewModels.FollowUps.FollowUpDetailsViewModel
@using AcxiomCrm.Domain.Enums
@using AcxiomCrm.Web.Presentation

@{
    var detail = Model.Detail;
    ViewData["Title"] = $"{detail.Subject} - Follow-up Details";
    ViewData["Page"] = "followups";

    var relController = detail.RelatedType switch
    {
        RelatedType.Customer => "Customers",
        RelatedType.Lead => "Leads",
        RelatedType.Opportunity => "Opportunities",
        _ => ""
    };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center gap-3">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to follow-ups
        </a>
        <div>
            <div class="d-flex align-items-center gap-2">
                <h1 class="h3 mb-0">@detail.Subject</h1>
                <partial name="_StatusBadge" model='StatusBadges.For("FollowUp", detail.Status)' />
                <span class="badge bg-light text-dark border">@Labels.For(detail.Type)</span>
                @if (detail.IsOverdue)
                {
                    <span class="badge bg-danger">Overdue</span>
                }
            </div>
            <div class="text-muted small mt-1">
                Scheduled for @detail.FollowUpDateUtc.ToString("dd MMM yyyy, HH:mm") UTC
            </div>
        </div>
    </div>
    <div class="d-flex gap-2">
        @if (Model.CanComplete)
        {
            <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#completeModal">
                <i class="bi bi-check-lg"></i> Complete
            </button>
            <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#rescheduleModal">
                <i class="bi bi-calendar-event"></i> Reschedule
            </button>
        }
        @if (Model.CanEdit)
        {
            <a asp-action="Edit" asp-route-id="@detail.Id" class="btn btn-outline-secondary">
                Edit
            </a>
        }
        @if (Model.CanDelete)
        {
            <form method="post" asp-action="Delete" asp-route-id="@detail.Id" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger" onclick="return confirm('Delete this follow-up?');">
                    Delete
                </button>
            </form>
        }
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <!-- Main Details -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="card-title mb-0">Follow-up Information</h5>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">Related to</dt>
                    <dd class="col-sm-8">
                        @if (!string.IsNullOrEmpty(relController) && detail.RelatedId > 0)
                        {
                            <a asp-controller="@relController" asp-action="Details" asp-route-id="@detail.RelatedId" class="text-decoration-none fw-semibold">
                                <span class="badge bg-light text-dark border me-1">@detail.RelatedType</span>
                                @detail.RelatedName
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">@detail.RelatedName</span>
                        }
                    </dd>

                    <dt class="col-sm-4 text-muted">Follow-up Date</dt>
                    <dd class="col-sm-8 @(detail.IsOverdue ? "text-danger fw-semibold" : "")">
                        @detail.FollowUpDateUtc.ToString("dd MMM yyyy, HH:mm") UTC
                    </dd>

                    <dt class="col-sm-4 text-muted">Status</dt>
                    <dd class="col-sm-8">
                        <partial name="_StatusBadge" model='StatusBadges.For("FollowUp", detail.Status)' />
                    </dd>

                    <dt class="col-sm-4 text-muted">Type</dt>
                    <dd class="col-sm-8">@Labels.For(detail.Type)</dd>

                    <dt class="col-sm-4 text-muted">Assigned to</dt>
                    <dd class="col-sm-8">@detail.AssignedToName</dd>

                    <dt class="col-sm-4 text-muted">Reschedule Count</dt>
                    <dd class="col-sm-8">@(detail.RescheduleCount > 0 ? $"{detail.RescheduleCount} time(s)" : "None")</dd>

                    @if (detail.CompletedDate.HasValue)
                    {
                        <dt class="col-sm-4 text-muted">Completed on</dt>
                        <dd class="col-sm-8">@detail.CompletedDate.Value.ToString("dd MMM yyyy, HH:mm") UTC</dd>
                    }

                    <dt class="col-sm-4 text-muted">Created on</dt>
                    <dd class="col-sm-8">@detail.CreatedDate.ToString("dd MMM yyyy, HH:mm") UTC</dd>

                    <dt class="col-sm-4 text-muted">Remarks / Notes</dt>
                    <dd class="col-sm-8">
                        @if (!string.IsNullOrWhiteSpace(detail.Remarks))
                        {
                            <div class="p-3 bg-light rounded text-pre-wrap">@detail.Remarks</div>
                        }
                        else
                        {
                            <span class="text-muted fst-italic">No remarks entered.</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>

        <!-- Audit History -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h5 class="card-title mb-0">Audit History</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Date & Time</th>
                                <th>User</th>
                                <th>Action</th>
                                <th>Details</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.History.Count == 0)
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-3 text-muted">No audit records found.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var record in Model.History)
                                {
                                    <tr>
                                        <td class="small">@record.CreatedDateUtc.ToString("dd MMM yyyy, HH:mm")</td>
                                        <td class="small">@record.UserName</td>
                                        <td>
                                            <span class="badge bg-light text-dark border">@record.Action</span>
                                        </td>
                                        <td class="small text-muted">@record.Details</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Complete Modal -->
<div class="modal fade" id="completeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-action="Complete" asp-route-id="@detail.Id">
                @Html.AntiForgeryToken()
                <input type="hidden" name="RowVersion" value="@Convert.ToBase64String(detail.RowVersion)" />
                <div class="modal-header">
                    <h5 class="modal-title">Complete Follow-up</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small">Outcome / Remarks</label>
                        <textarea name="Remarks" class="form-control" rows="3" placeholder="Enter notes about the outcome..."></textarea>
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" name="LogActivity" id="logActModal" value="true" checked />
                        <label class="form-check-label small" for="logActModal">
                            Log as completed activity automatically
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="ScheduleNext" id="schedNextModal" value="true" />
                        <label class="form-check-label small" for="schedNextModal">
                            Schedule next follow-up immediately
                        </label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-success">Mark Completed</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Reschedule Modal -->
<div class="modal fade" id="rescheduleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-action="Reschedule" asp-route-id="@detail.Id">
                @Html.AntiForgeryToken()
                <input type="hidden" name="RowVersion" value="@Convert.ToBase64String(detail.RowVersion)" />
                <div class="modal-header">
                    <h5 class="modal-title">Reschedule Follow-up</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small">New Date</label>
                        <input type="date" name="NewDate" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small">New Time</label>
                        <input type="time" name="NewTime" class="form-control" value="10:00" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary">Reschedule</button>
                </div>
            </form>
        </div>
    </div>
</div>
