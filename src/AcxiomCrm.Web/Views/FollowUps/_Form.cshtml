@model AcxiomCrm.Web.ViewModels.FollowUps.FollowUpFormViewModel
@inject AcxiomCrm.Application.Abstractions.IClock Clock
@using AcxiomCrm.Domain.Enums
@using AcxiomCrm.Web.Presentation

<input type="hidden" asp-for="Id" />
<input type="hidden" asp-for="RowVersion" />

<div class="row g-3">
    <!-- Related Record -->
    <div class="col-md-4">
        <label asp-for="RelatedType" class="form-label">Related to <span class="text-danger">*</span></label>
        <select asp-for="RelatedType" class="form-select" id="fuRelatedType">
            <option value="@RelatedType.Customer">Customer</option>
            <option value="@RelatedType.Lead">Lead</option>
            <option value="@RelatedType.Opportunity">Opportunity</option>
        </select>
        <span asp-validation-for="RelatedType" class="text-danger small"></span>
    </div>

    <div class="col-md-8">
        <label asp-for="RelatedId" class="form-label">Record ID / Name <span class="text-danger">*</span></label>
        @if (!string.IsNullOrEmpty(Model.RelatedName))
        {
            <div class="input-group">
                <input type="text" class="form-control" value="@Model.RelatedName" readonly />
                <input type="hidden" asp-for="RelatedId" />
                <input type="hidden" asp-for="RelatedName" />
            </div>
        }
        else
        {
            <input type="number" asp-for="RelatedId" class="form-control" placeholder="Enter target Record ID" />
        }
        <span asp-validation-for="RelatedId" class="text-danger small"></span>
    </div>

    <!-- Subject -->
    <div class="col-md-8">
        <label asp-for="Subject" class="form-label">Subject <span class="text-danger">*</span></label>
        <input asp-for="Subject" class="form-control" placeholder="e.g. Follow-up regarding proposal terms" />
        <span asp-validation-for="Subject" class="text-danger small"></span>
    </div>

    <!-- Type -->
    <div class="col-md-4">
        <label asp-for="Type" class="form-label">Type <span class="text-danger">*</span></label>
        <select asp-for="Type" class="form-select">
            @foreach (var t in Enum.GetValues<FollowUpType>())
            {
                <option value="@t">@Labels.For(t)</option>
            }
        </select>
        <span asp-validation-for="Type" class="text-danger small"></span>
    </div>

    <!-- Date & Time -->
    <div class="col-md-6">
        <label asp-for="FollowUpDate" class="form-label">Follow-up date <span class="text-danger">*</span></label>
        <input type="date" asp-for="FollowUpDate" class="form-control" min="@Clock.Today.ToString("yyyy-MM-dd")" />
        <span asp-validation-for="FollowUpDate" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="FollowUpTime" class="form-label">Time <span class="text-danger">*</span></label>
        <input type="time" asp-for="FollowUpTime" class="form-control" />
        <span asp-validation-for="FollowUpTime" class="text-danger small"></span>
    </div>

    <!-- Assignee -->
    @if (Model.AssigneeOptions.Count > 0)
    {
        <div class="col-md-6">
            <label asp-for="AssignedToId" class="form-label">Assign to</label>
            <select asp-for="AssignedToId" class="form-select">
                @foreach (var opt in Model.AssigneeOptions)
                {
                    <option value="@opt.Id">@opt.Name</option>
                }
            </select>
            <span asp-validation-for="AssignedToId" class="text-danger small"></span>
        </div>
    }

    <!-- Remarks -->
    <div class="col-12">
        <label asp-for="Remarks" class="form-label">Remarks / Agenda</label>
        <textarea asp-for="Remarks" class="form-control" rows="3" placeholder="Add preparation notes or discussion points..."></textarea>
        <span asp-validation-for="Remarks" class="text-danger small"></span>
    </div>
</div>
