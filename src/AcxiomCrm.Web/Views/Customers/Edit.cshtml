@model AcxiomCrm.Web.ViewModels.Customers.CustomerFormViewModel

@{
    ViewData["Title"] = $"Edit {Model.Name}";
    ViewData["Page"] = "customers";
}

<div class="mb-4">
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-sm btn-link text-decoration-none px-0 mb-2">
        &larr; Back to customer details
    </a>
    <h1 class="h3 mb-1">Edit Customer</h1>
    <p class="text-muted small mb-0">Update customer details, contact info, and status.</p>
</div>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" id="customerEditForm">
    <partial name="_Form" model="Model" />

    <div class="d-flex align-items-center gap-2 mb-5">
        <button type="submit" class="btn btn-primary">Save changes</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
