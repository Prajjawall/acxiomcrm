@model AcxiomCrm.Web.ViewModels.Customers.CustomerListViewModel
@using AcxiomCrm.Domain.Enums
@using AcxiomCrm.Web.Presentation

@{
    ViewData["Title"] = "Customers";
    ViewData["Page"] = "customers";

    var isFiltered = !string.IsNullOrWhiteSpace(Model.Filter.Search)
        || Model.Filter.Status.HasValue
        || !string.IsNullOrWhiteSpace(Model.Filter.OwnerId);

    var pagerQuery = new Dictionary<string, string?>(StringComparer.OrdinalIgnoreCase);
    if (!string.IsNullOrWhiteSpace(Model.Filter.Search)) pagerQuery["search"] = Model.Filter.Search;
    if (Model.Filter.Status.HasValue) pagerQuery["status"] = Model.Filter.Status.Value.ToString();
    if (!string.IsNullOrWhiteSpace(Model.Filter.OwnerId)) pagerQuery["ownerId"] = Model.Filter.OwnerId;
    if (Model.PageQuery.PageSize != 20) pagerQuery["pageSize"] = Model.PageQuery.PageSize.ToString();
    if (!string.IsNullOrWhiteSpace(Model.PageQuery.Sort)) pagerQuery["sort"] = Model.PageQuery.Sort;
    if (Model.PageQuery.Desc) pagerQuery["desc"] = "true";

    var pagerModel = new PagerModel(
        Model.Result.Page,
        Model.Result.PageSize,
        Model.Result.Total,
        "Index",
        pagerQuery);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Customers</h1>
        <p class="text-muted small mb-0">Manage customer accounts, contacts, and assignments.</p>
    </div>
    @if (Model.CanCreate)
    {
        <a asp-action="Create" class="btn btn-primary">
            Create customer
        </a>
    }
</div>

<!-- Filter Bar -->
<div class="card mb-4 border-0 shadow-sm">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" id="customerFilterForm" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-transparent text-muted"><i class="bi bi-search"></i>Search</span>
                    <input type="text" name="search" id="customerSearchInput" class="form-control"
                           placeholder="Search by code, name, email, phone..." value="@Model.Filter.Search" />
                </div>
            </div>

            <div class="col-md-3">
                <select name="status" class="form-select form-select-sm" id="customerStatusSelect">
                    <option value="">All Statuses</option>
                    <option value="@CustomerStatus.Active" selected="@(Model.Filter.Status == CustomerStatus.Active)">Active</option>
                    <option value="@CustomerStatus.Inactive" selected="@(Model.Filter.Status == CustomerStatus.Inactive)">Inactive</option>
                </select>
            </div>

            @if (Model.OwnerOptions.Count > 0)
            {
                <div class="col-md-3">
                    <select name="ownerId" class="form-select form-select-sm" id="customerOwnerSelect">
                        <option value="">All Owners</option>
                        @foreach (var owner in Model.OwnerOptions)
                        {
                            <option value="@owner.Id" selected="@(Model.Filter.OwnerId == owner.Id)">@owner.Name (@owner.Role)</option>
                        }
                    </select>
                </div>
            }

            <div class="col-auto d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary">Filter</button>
                @if (isFiltered)
                {
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Clear</a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Customers Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        @if (Model.Result.Items.Count > 0)
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="customersTable">
                    <thead class="table-light text-muted small text-uppercase">
                        <tr>
                            <th scope="col" style="width: 140px;">Code</th>
                            <th scope="col">Customer</th>
                            <th scope="col">Email</th>
                            <th scope="col">Phone</th>
                            <th scope="col">Status</th>
                            <th scope="col">Owner</th>
                            <th scope="col">Created</th>
                            <th scope="col" class="text-end" style="width: 120px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var customer in Model.Result.Items)
                        {
                            <partial name="_Row" model="customer" />
                        }
                    </tbody>
                </table>
            </div>

            <div class="p-3 border-top">
                <partial name="_Pager" model="pagerModel" />
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <div class="text-muted mb-3">
                    <i class="bi bi-inbox fs-1"></i>
                </div>
                @if (isFiltered)
                {
                    <h5 class="fw-semibold">No customers match these filters</h5>
                    <p class="text-muted small mb-3">Try adjusting your search terms or filter selections.</p>
                    <a asp-action="Index" class="btn btn-outline-primary btn-sm">Clear filters</a>
                }
                else
                {
                    <h5 class="fw-semibold">No customers found</h5>
                    <p class="text-muted small mb-3">Get started by creating your first customer record.</p>
                    @if (Model.CanCreate)
                    {
                        <a asp-action="Create" class="btn btn-primary btn-sm">Create customer</a>
                    }
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/customers.js"></script>
}
