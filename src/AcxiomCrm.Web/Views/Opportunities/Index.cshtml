@model AcxiomCrm.Web.ViewModels.Opportunities.OpportunityListViewModel
@using AcxiomCrm.Domain.Enums
@using AcxiomCrm.Domain.Security
@using AcxiomCrm.Web.Presentation

@{
    ViewData["Title"] = "Opportunities";
    ViewData["Page"] = "opportunities";

    var isFiltered = !string.IsNullOrWhiteSpace(Model.Filter.Search)
        || Model.Filter.Stage.HasValue
        || Model.Filter.Status.HasValue
        || !string.IsNullOrWhiteSpace(Model.Filter.OwnerId)
        || Model.Filter.CustomerId.HasValue;

    var pagerQuery = new Dictionary<string, string?>(StringComparer.OrdinalIgnoreCase);
    if (!string.IsNullOrWhiteSpace(Model.Filter.Search)) pagerQuery["search"] = Model.Filter.Search;
    if (Model.Filter.Stage.HasValue) pagerQuery["stage"] = Model.Filter.Stage.Value.ToString();
    if (Model.Filter.Status.HasValue) pagerQuery["status"] = Model.Filter.Status.Value.ToString();
    if (!string.IsNullOrWhiteSpace(Model.Filter.OwnerId)) pagerQuery["ownerId"] = Model.Filter.OwnerId;
    if (Model.Filter.CustomerId.HasValue) pagerQuery["customerId"] = Model.Filter.CustomerId.Value.ToString();
    if (Model.PageQuery.PageSize != 25) pagerQuery["pageSize"] = Model.PageQuery.PageSize.ToString();
    if (!string.IsNullOrWhiteSpace(Model.PageQuery.Sort)) pagerQuery["sort"] = Model.PageQuery.Sort;
    if (Model.PageQuery.Desc) pagerQuery["desc"] = "true";

    var pagerModel = new PagerModel(
        Model.Result.Page,
        Model.Result.PageSize,
        Model.Result.Total,
        "Index",
        pagerQuery);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Opportunities</h1>
        <p class="text-muted small mb-0">Track pipeline deals, stages, probabilities, and revenue forecasts.</p>
    </div>
    @if (User.HasClaim(c => c.Type == System.Security.Claims.ClaimTypes.Role && (c.Value == Roles.Admin || c.Value == Roles.Manager || c.Value == Roles.SalesExecutive)))
    {
        <a asp-action="Create" class="btn btn-primary" id="createOppButton">
            New opportunity
        </a>
    }
</div>

<!-- Filter Bar -->
<div class="card mb-4 border-0 shadow-sm">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" id="oppFilterForm" class="row g-2 align-items-center">
            <div class="col-md-3">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-transparent text-muted"><i class="bi bi-search"></i>Search</span>
                    <input type="text" name="search" id="oppSearchInput" class="form-control"
                           placeholder="Search name, code, customer..." value="@Model.Filter.Search" />
                </div>
            </div>

            <div class="col-md-2">
                <select name="status" class="form-select form-select-sm" id="oppStatusSelect">
                    <option value="">All Statuses</option>
                    @foreach (var s in Enum.GetValues<OpportunityStatus>())
                    {
                        <option value="@s" selected="@(Model.Filter.Status == s)">@Labels.For(s)</option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <select name="stage" class="form-select form-select-sm" id="oppStageSelect">
                    <option value="">All Stages</option>
                    @foreach (var stg in Enum.GetValues<OpportunityStage>())
                    {
                        <option value="@stg" selected="@(Model.Filter.Stage == stg)">@Labels.For(stg)</option>
                    }
                </select>
            </div>

            @if (Model.OwnerOptions.Count > 0)
            {
                <div class="col-md-3">
                    <select name="ownerId" class="form-select form-select-sm" id="oppOwnerSelect">
                        <option value="">All Owners</option>
                        @foreach (var owner in Model.OwnerOptions)
                        {
                            <option value="@owner.Id" selected="@(Model.Filter.OwnerId == owner.Id)">@owner.Name (@owner.Role)</option>
                        }
                    </select>
                </div>
            }

            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-outline-secondary w-100">Filter</button>
                @if (isFiltered)
                {
                    <a asp-action="Index" class="btn btn-sm btn-link text-decoration-none text-muted">Clear</a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Opportunities Table -->
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light text-muted small text-uppercase">
                <tr>
                    <th scope="col" style="min-width: 220px;">Opportunity</th>
                    <th scope="col" style="min-width: 180px;">Customer</th>
                    <th scope="col" class="text-end" style="min-width: 130px;">Amount</th>
                    <th scope="col" class="text-end" style="min-width: 140px;">Weighted (Prob.)</th>
                    <th scope="col" style="min-width: 130px;">Stage</th>
                    <th scope="col" style="min-width: 140px;">Expected Close</th>
                    <th scope="col" style="min-width: 140px;">Owner</th>
                    <th scope="col" class="text-end" style="width: 80px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Result.Items.Count > 0)
                {
                    @foreach (var opp in Model.Result.Items)
                    {
                        <tr>
                            <td>
                                <div>
                                    <a asp-action="Details" asp-route-id="@opp.Id" class="fw-semibold text-decoration-none text-dark">
                                        @opp.Name
                                    </a>
                                </div>
                            </td>
                            <td>
                                <a asp-controller="Customers" asp-action="Details" asp-route-id="@opp.CustomerId" class="text-decoration-none text-primary">
                                    @opp.CustomerName
                                </a>
                                <span class="text-muted small font-monospace">(@opp.CustomerCode)</span>
                            </td>
                            <td class="text-end ax-num fw-semibold">
                                @Formatters.Money(opp.Amount)
                            </td>
                            <td class="text-end ax-num">
                                <span class="fw-medium">@Formatters.Money(opp.WeightedAmount)</span>
                                <span class="text-muted small">(@opp.Probability%)</span>
                            </td>
                            <td>
                                <partial name="_StatusBadge" model='StatusBadges.For("Opportunity", opp.Stage)' />
                            </td>
                            <td>
                                <span>@Formatters.Date(opp.ExpectedCloseDate)</span>
                                @if (opp.CloseDateOverdue)
                                {
                                    <span class="badge bg-danger-subtle text-danger ms-1" id="overdueBadge-@opp.Id">Overdue</span>
                                }
                            </td>
                            <td class="small text-muted">
                                @opp.OwnerName
                            </td>
                            <td class="text-end">
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-light border-0" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                        <li>
                                            <a class="dropdown-item" asp-action="Details" asp-route-id="@opp.Id">
                                                View details
                                            </a>
                                        </li>
                                        @if (opp.Status == OpportunityStatus.Open)
                                        {
                                            <li>
                                                <a class="dropdown-item" asp-action="Edit" asp-route-id="@opp.Id">
                                                    Edit
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <p class="mb-1 fw-semibold">No opportunities found</p>
                            <span class="small">Try adjusting search filters or create a new opportunity.</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.Result.Total > 0)
    {
        <div class="card-footer bg-white border-0 py-3">
            <partial name="_Pager" model="pagerModel" />
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/opportunities.js"></script>
}
