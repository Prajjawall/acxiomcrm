@model AcxiomCrm.Web.ViewModels.Users.UserFormViewModel

@{
    ViewData["Title"] = $"Edit {Model.FullName}";
    ViewData["Page"] = "users-edit";
}

<div class="mb-4">
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-sm btn-link text-muted p-0 text-decoration-none">
        &larr; Back to details
    </a>
    <h1 class="h3 mt-2 mb-1">Edit user</h1>
    <p class="text-muted small mb-0">Update account details, role assignments, or manager hierarchy.</p>
</div>

<div class="card border-0 shadow-sm col-lg-8">
    <div class="card-body p-4">
        <form method="post" asp-action="Edit" asp-route-id="@Model.Id" id="editUserForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

            <partial name="_Form" model="Model" />

            <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary" id="saveUserBtn">
                    Save Changes
                </button>
            </div>
        </form>
    </div>
</div>
