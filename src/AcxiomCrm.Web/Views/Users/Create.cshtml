@model AcxiomCrm.Web.ViewModels.Users.UserFormViewModel

@{
    ViewData["Title"] = "Create User";
    ViewData["Page"] = "users-create";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-sm btn-link text-muted p-0 text-decoration-none">
        &larr; Back to users
    </a>
    <h1 class="h3 mt-2 mb-1">Create user</h1>
    <p class="text-muted small mb-0">Create a new user account with role-based CRM permissions.</p>
</div>

<div class="card border-0 shadow-sm col-lg-8">
    <div class="card-body p-4">
        <form method="post" asp-action="Create" id="createUserForm">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

            <partial name="_Form" model="Model" />

            <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary" id="saveUserBtn">
                    Create User
                </button>
            </div>
        </form>
    </div>
</div>
