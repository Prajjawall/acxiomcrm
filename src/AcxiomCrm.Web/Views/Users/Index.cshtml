@model AcxiomCrm.Web.ViewModels.Users.UserListViewModel
@using AcxiomCrm.Domain.Security
@using AcxiomCrm.Web.Presentation

@{
    ViewData["Title"] = "User Administration";
    ViewData["Page"] = "users";

    var isFiltered = !string.IsNullOrWhiteSpace(Model.Filter.Search)
        || !string.IsNullOrWhiteSpace(Model.Filter.Role)
        || Model.Filter.Active.HasValue
        || Model.Filter.LockedOut.HasValue
        || !string.IsNullOrWhiteSpace(Model.Filter.ManagerId);

    var pagerQuery = new Dictionary<string, string?>(StringComparer.OrdinalIgnoreCase);
    if (!string.IsNullOrWhiteSpace(Model.Filter.Search)) pagerQuery["search"] = Model.Filter.Search;
    if (!string.IsNullOrWhiteSpace(Model.Filter.Role)) pagerQuery["role"] = Model.Filter.Role;
    if (Model.Filter.Active.HasValue) pagerQuery["active"] = Model.Filter.Active.Value.ToString();
    if (Model.Filter.LockedOut.HasValue) pagerQuery["lockedOut"] = Model.Filter.LockedOut.Value.ToString();
    if (!string.IsNullOrWhiteSpace(Model.Filter.ManagerId)) pagerQuery["managerId"] = Model.Filter.ManagerId;
    if (Model.PageQuery.PageSize != 25) pagerQuery["pageSize"] = Model.PageQuery.PageSize.ToString();

    var pagerModel = new PagerModel(
        Model.Result.Page,
        Model.Result.PageSize,
        Model.Result.Total,
        "Index",
        pagerQuery);

    var isAdmin = User.IsInRole(Roles.Admin);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Users</h1>
        <p class="text-muted small mb-0">Role-based accounts, security credentials, and manager assignments.</p>
    </div>
    @if (isAdmin)
    {
        <a asp-action="Create" class="btn btn-primary" id="createUserBtn">
            Create user
        </a>
    }
</div>

<!-- Filter Bar -->
<div class="card mb-4 border-0 shadow-sm">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" id="userFilterForm" class="row g-2 align-items-center">
            <div class="col-md-3">
                <input type="text" name="search" id="userSearchInput" class="form-control form-control-sm"
                       placeholder="Search name, username, email..." value="@Model.Filter.Search" />
            </div>

            <div class="col-md-2">
                <select name="role" class="form-select form-select-sm" id="userRoleSelect">
                    <option value="">All Roles</option>
                    <option value="@Roles.Admin" selected="@(Model.Filter.Role == Roles.Admin)">Admin</option>
                    <option value="@Roles.Manager" selected="@(Model.Filter.Role == Roles.Manager)">Manager</option>
                    <option value="@Roles.SalesExecutive" selected="@(Model.Filter.Role == Roles.SalesExecutive)">Sales Executive</option>
                </select>
            </div>

            <div class="col-md-2">
                <select name="active" class="form-select form-select-sm" id="userActiveSelect">
                    <option value="">All Statuses</option>
                    <option value="true" selected="@(Model.Filter.Active == true)">Active</option>
                    <option value="false" selected="@(Model.Filter.Active == false)">Inactive</option>
                </select>
            </div>

            <div class="col-md-2">
                <select name="lockedOut" class="form-select form-select-sm" id="userLockedSelect">
                    <option value="">All Accounts</option>
                    <option value="true" selected="@(Model.Filter.LockedOut == true)">Locked out</option>
                    <option value="false" selected="@(Model.Filter.LockedOut == false)">Not locked</option>
                </select>
            </div>

            @if (Model.ManagerOptions.Count > 0)
            {
                <div class="col-md-2">
                    <select name="managerId" class="form-select form-select-sm" id="userManagerSelect">
                        <option value="">All Managers</option>
                        @foreach (var mgr in Model.ManagerOptions)
                        {
                            <option value="@mgr.Id" selected="@(Model.Filter.ManagerId == mgr.Id)">@mgr.Name</option>
                        }
                    </select>
                </div>
            }

            <div class="col-auto d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary">Filter</button>
                @if (isFiltered)
                {
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Reset</a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Table Card -->
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" id="usersTable">
            <thead class="table-light">
                <tr>
                    <th scope="col">Name &amp; Username</th>
                    <th scope="col">Email</th>
                    <th scope="col">Role</th>
                    <th scope="col">Manager</th>
                    <th scope="col">Status</th>
                    <th scope="col">Last Login</th>
                    <th scope="col" class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Result.Items.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <p class="mb-0">No users found matching your criteria.</p>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var user in Model.Result.Items)
                    {
                        <tr>
                            <td>
                                <a asp-action="Details" asp-route-id="@user.Id" class="fw-semibold text-decoration-none">
                                    @user.FullName
                                </a>
                                <div class="text-muted small">@@@user.UserName</div>
                            </td>
                            <td>
                                <a href="mailto:@user.Email" class="text-muted text-decoration-none small">@user.Email</a>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@user.Role</span>
                            </td>
                            <td>
                                @(string.IsNullOrWhiteSpace(user.ManagerName) ? "—" : user.ManagerName)
                            </td>
                            <td>
                                @if (user.LockedOut)
                                {
                                    <span class="badge bg-danger">Locked</span>
                                }
                                else if (user.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td class="small text-muted">
                                @(user.LastLoginDateUtc.HasValue ? user.LastLoginDateUtc.Value.ToString("yyyy-MM-dd HH:mm") : "Never")
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@user.Id" class="btn btn-sm btn-outline-secondary py-0 px-2" title="View details">
                                    View
                                </a>
                                @if (isAdmin)
                                {
                                    <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary py-0 px-2 ms-1" title="Edit user">
                                        Edit
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (Model.Result.Total > 0)
    {
        <div class="card-footer bg-white border-0 py-3">
            <partial name="_Pager" model="pagerModel" />
        </div>
    }
</div>
