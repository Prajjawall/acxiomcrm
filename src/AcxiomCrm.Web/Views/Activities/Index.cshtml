@model AcxiomCrm.Web.ViewModels.Activities.ActivityListViewModel
@using AcxiomCrm.Domain.Enums
@using AcxiomCrm.Domain.Security
@using AcxiomCrm.Web.Presentation

@{
    ViewData["Title"] = "Activities";
    ViewData["Page"] = "activities";

    var pagerQuery = new Dictionary<string, string?>(StringComparer.OrdinalIgnoreCase);
    if (Model.Filter.Type.HasValue) pagerQuery["type"] = Model.Filter.Type.Value.ToString();
    if (Model.Filter.Status.HasValue) pagerQuery["status"] = Model.Filter.Status.Value.ToString();
    if (!string.IsNullOrWhiteSpace(Model.Filter.AssignedToId)) pagerQuery["assignedToId"] = Model.Filter.AssignedToId;
    if (Model.Filter.From.HasValue) pagerQuery["from"] = Model.Filter.From.Value.ToString("yyyy-MM-dd");
    if (Model.Filter.To.HasValue) pagerQuery["to"] = Model.Filter.To.Value.ToString("yyyy-MM-dd");
    if (Model.PageQuery.PageSize != 25) pagerQuery["pageSize"] = Model.PageQuery.PageSize.ToString();

    var pagerModel = new PagerModel(
        Model.Result.Page,
        Model.Result.PageSize,
        Model.Result.Total,
        "Index",
        pagerQuery);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Activities</h1>
        <p class="text-muted small mb-0">Review completed and planned customer interactions, calls, meetings, and emails.</p>
    </div>
    @if (User.HasClaim(c => c.Type == System.Security.Claims.ClaimTypes.Role && (c.Value == Roles.Admin || c.Value == Roles.Manager || c.Value == Roles.SalesExecutive)))
    {
        <a asp-action="Create" class="btn btn-primary" id="createActivityButton">
            Log activity
        </a>
    }
</div>

<!-- Filter Bar -->
<div class="card mb-4 border-0 shadow-sm">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-2">
                <select name="type" class="form-select form-select-sm">
                    <option value="">All Types</option>
                    @foreach (var t in Enum.GetValues<ActivityType>())
                    {
                        <option value="@t" selected="@(Model.Filter.Type == t)">@Labels.For(t)</option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <select name="status" class="form-select form-select-sm">
                    <option value="">All Statuses</option>
                    @foreach (var s in Enum.GetValues<ActivityStatus>())
                    {
                        <option value="@s" selected="@(Model.Filter.Status == s)">@Labels.For(s)</option>
                    }
                </select>
            </div>

            @if (Model.AssigneeOptions.Count > 0)
            {
                <div class="col-md-2">
                    <select name="assignedToId" class="form-select form-select-sm">
                        <option value="">All Assignees</option>
                        @foreach (var u in Model.AssigneeOptions)
                        {
                            <option value="@u.Id" selected="@(Model.Filter.AssignedToId == u.Id)">@u.Name</option>
                        }
                    </select>
                </div>
            }

            <div class="col-md-2">
                <input type="date" name="from" class="form-control form-control-sm" placeholder="From date"
                       value="@(Model.Filter.From?.ToString("yyyy-MM-dd"))" />
            </div>

            <div class="col-md-2">
                <input type="date" name="to" class="form-control form-control-sm" placeholder="To date"
                       value="@(Model.Filter.To?.ToString("yyyy-MM-dd"))" />
            </div>

            <div class="col-auto ms-auto d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-outline-primary">Filter</button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- List Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 25%;">Subject</th>
                        <th style="width: 20%;">Related records</th>
                        <th style="width: 15%;">Date & Time</th>
                        <th style="width: 10%;">Type</th>
                        <th style="width: 10%;">Status</th>
                        <th style="width: 10%;">Assignee</th>
                        <th style="width: 10%;" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Result.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-clock-history display-6 d-block mb-2 text-muted"></i>
                                No activities found matching criteria.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Result.Items)
                        {
                            <tr>
                                <td>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="fw-semibold text-decoration-none">
                                        @item.Subject
                                    </a>
                                </td>
                                <td>
                                    @foreach (var rel in item.Related)
                                    {
                                        var ctrl = rel.Type switch
                                        {
                                            RelatedType.Customer => "Customers",
                                            RelatedType.Lead => "Leads",
                                            RelatedType.Opportunity => "Opportunities",
                                            _ => ""
                                        };
                                        <a asp-controller="@ctrl" asp-action="Details" asp-route-id="@rel.Id" class="badge bg-light text-dark border text-decoration-none me-1">
                                            @rel.Type #@rel.Id
                                        </a>
                                    }
                                </td>
                                <td class="small">
                                    @item.ActivityDateUtc.ToString("dd MMM yyyy, HH:mm") UTC
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@Labels.For(item.Type)</span>
                                </td>
                                <td>
                                    <partial name="_StatusBadge" model='StatusBadges.For("Activity", item.Status)' />
                                </td>
                                <td>
                                    <span class="small text-muted">@item.AssignedToName</span>
                                </td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">
                                        View
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="mt-4">
    <partial name="_Pager" model="pagerModel" />
</div>
