@model AcxiomCrm.Web.ViewModels.Activities.ActivityFormViewModel
@using AcxiomCrm.Domain.Enums
@using AcxiomCrm.Web.Presentation

<input type="hidden" asp-for="Id" />
<input type="hidden" asp-for="RowVersion" />

<div class="row g-3">
    <!-- Subject -->
    <div class="col-md-8">
        <label asp-for="Subject" class="form-label">Subject <span class="text-danger">*</span></label>
        <input asp-for="Subject" class="form-control" placeholder="e.g. Contract review call" />
        <span asp-validation-for="Subject" class="text-danger small"></span>
    </div>

    <!-- Type -->
    <div class="col-md-4">
        <label asp-for="Type" class="form-label">Type <span class="text-danger">*</span></label>
        <select asp-for="Type" class="form-select">
            @foreach (var t in Enum.GetValues<ActivityType>())
            {
                <option value="@t">@Labels.For(t)</option>
            }
        </select>
        <span asp-validation-for="Type" class="text-danger small"></span>
    </div>

    <!-- Date & Time -->
    <div class="col-md-4">
        <label asp-for="ActivityDate" class="form-label">Date <span class="text-danger">*</span></label>
        <input type="date" asp-for="ActivityDate" class="form-control" />
        <span asp-validation-for="ActivityDate" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="ActivityTime" class="form-label">Time <span class="text-danger">*</span></label>
        <input type="time" asp-for="ActivityTime" class="form-control" />
        <span asp-validation-for="ActivityTime" class="text-danger small"></span>
    </div>

    <!-- Status -->
    <div class="col-md-4">
        <label asp-for="Status" class="form-label">Status <span class="text-danger">*</span></label>
        <select asp-for="Status" class="form-select">
            @foreach (var s in Enum.GetValues<ActivityStatus>())
            {
                <option value="@s">@Labels.For(s)</option>
            }
        </select>
        <span asp-validation-for="Status" class="text-danger small"></span>
    </div>

    <!-- Related Records -->
    <div class="col-12">
        <div class="card bg-light border-0 p-3">
            <h6 class="card-subtitle mb-2 text-muted">Related Records (specify at least one)</h6>
            <div class="row g-2">
                <div class="col-md-4">
                    <label asp-for="CustomerId" class="form-label small">Customer ID</label>
                    <input type="number" asp-for="CustomerId" class="form-control form-control-sm" placeholder="Customer ID" />
                    @if (!string.IsNullOrEmpty(Model.CustomerName))
                    {
                        <div class="text-muted small mt-1">@Model.CustomerName</div>
                    }
                </div>
                <div class="col-md-4">
                    <label asp-for="LeadId" class="form-label small">Lead ID</label>
                    <input type="number" asp-for="LeadId" class="form-control form-control-sm" placeholder="Lead ID" />
                    @if (!string.IsNullOrEmpty(Model.LeadName))
                    {
                        <div class="text-muted small mt-1">@Model.LeadName</div>
                    }
                </div>
                <div class="col-md-4">
                    <label asp-for="OpportunityId" class="form-label small">Opportunity ID</label>
                    <input type="number" asp-for="OpportunityId" class="form-control form-control-sm" placeholder="Opportunity ID" />
                    @if (!string.IsNullOrEmpty(Model.OpportunityName))
                    {
                        <div class="text-muted small mt-1">@Model.OpportunityName</div>
                    }
                </div>
            </div>
            <span asp-validation-for="CustomerId" class="text-danger small"></span>
        </div>
    </div>

    <!-- Assignee -->
    @if (Model.AssigneeOptions.Count > 0)
    {
        <div class="col-md-6">
            <label asp-for="AssignedToId" class="form-label">Assigned to</label>
            <select asp-for="AssignedToId" class="form-select">
                @foreach (var opt in Model.AssigneeOptions)
                {
                    <option value="@opt.Id">@opt.Name</option>
                }
            </select>
            <span asp-validation-for="AssignedToId" class="text-danger small"></span>
        </div>
    }

    <!-- Description -->
    <div class="col-12">
        <label asp-for="Description" class="form-label">Description / Summary</label>
        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Enter key points discussed or action items..."></textarea>
        <span asp-validation-for="Description" class="text-danger small"></span>
    </div>
</div>
