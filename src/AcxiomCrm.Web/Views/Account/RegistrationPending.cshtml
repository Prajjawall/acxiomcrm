@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Registration Pending";
}

<div class="auth-card text-center">
    <div class="auth-header">
        <h2>Registration Submitted</h2>
        <p>Your account has been created and is pending administrator approval. You will be able to sign in once an administrator activates your account.</p>
    </div>

    <div class="mt-4">
        <a asp-action="Login" class="btn btn-primary">Return to Sign In</a>
    </div>
</div>
