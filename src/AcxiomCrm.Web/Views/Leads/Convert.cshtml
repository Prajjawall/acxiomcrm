@model AcxiomCrm.Web.ViewModels.Leads.ConvertLeadViewModel
@using AcxiomCrm.Web.Presentation

@{
    ViewData["Title"] = $"Convert {Model.LeadName}";
    ViewData["Page"] = "leads";
}

<div class="mb-4">
    <a asp-action="Details" asp-route-id="@Model.LeadId" class="btn btn-sm btn-link text-decoration-none px-0 mb-2">
        &larr; Back to lead details
    </a>
    <h1 class="h3 mb-1">Convert Lead</h1>
    <p class="text-muted small mb-0">Transform qualified lead <strong>@Model.LeadCode</strong> into a Customer account.</p>
</div>

<!-- Lead Summary Banner -->
<div class="card border-0 shadow-sm mb-4 bg-light">
    <div class="card-body p-3">
        <div class="row g-3 align-items-center">
            <div class="col-md-3">
                <div class="text-muted small text-uppercase fw-semibold">Lead</div>
                <div class="fw-semibold">@Model.LeadName</div>
                <div class="text-muted small font-monospace">@Model.LeadCode</div>
            </div>
            @if (!string.IsNullOrEmpty(Model.LeadCompanyName))
            {
                <div class="col-md-3">
                    <div class="text-muted small text-uppercase fw-semibold">Company</div>
                    <div>@Model.LeadCompanyName</div>
                </div>
            }
            <div class="col-md-3">
                <div class="text-muted small text-uppercase fw-semibold">Contact</div>
                <div class="small">@Model.LeadEmail</div>
                <div class="small text-muted">@Model.LeadPhone</div>
            </div>
            <div class="col-md-3 text-md-end">
                <div class="text-muted small text-uppercase fw-semibold">Expected Value</div>
                <div class="fw-bold fs-5 ax-num">@Formatters.Money(Model.ExpectedValue)</div>
            </div>
        </div>
    </div>
</div>

<form asp-action="Convert" asp-route-id="@Model.LeadId" method="post" id="convertLeadForm">
    <input type="hidden" asp-for="LeadId" />
    <input type="hidden" asp-for="LeadCode" />
    <input type="hidden" asp-for="LeadName" />
    <input type="hidden" asp-for="LeadCompanyName" />
    <input type="hidden" asp-for="LeadEmail" />
    <input type="hidden" asp-for="LeadPhone" />
    <input type="hidden" asp-for="ExpectedValue" />
    <input type="hidden" asp-for="SuggestedCustomerId" />
    <input type="hidden" asp-for="SuggestedCustomerLabel" />
    <input type="hidden" asp-for="IsOpportunityAvailable" />
    @if (Model.RowVersion != null && Model.RowVersion.Length > 0)
    {
        <input type="hidden" name="RowVersion" value="@Convert.ToBase64String(Model.RowVersion)" />
    }

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ContainsKey(string.Empty) && ViewData.ModelState[string.Empty]!.Errors.Count > 0)
    {
        <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
            <div>
                @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        </div>
    }

    <!-- Suggested Duplicate Alert -->
    @if (Model.SuggestedCustomerId.HasValue)
    {
        <div class="alert alert-warning border-0 shadow-sm d-flex align-items-center justify-content-between mb-4" role="alert" id="duplicateAlert">
            <div>
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <strong>Existing customer match found:</strong>
                <span class="ms-1" id="suggestedCustomerText">@Model.SuggestedCustomerLabel</span>
            </div>
            <button type="button" class="btn btn-sm btn-outline-dark" id="btnUseSuggested">
                Link to this customer
            </button>
        </div>
    }

    <!-- Target Customer Card -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white py-3">
            <h6 class="m-0 fw-semibold">Customer Account Destination</h6>
        </div>
        <div class="card-body">
            <!-- Mode Radio Selection -->
            <div class="mb-4">
                <div class="form-check mb-2">
                    <input class="form-check-input" type="radio" name="customerMode" id="modeNewCustomer" value="new"
                           checked="@(!Model.ExistingCustomerId.HasValue)">
                    <label class="form-check-label fw-semibold" for="modeNewCustomer">
                        Create new customer account
                    </label>
                    <div class="form-text text-muted small ms-4">
                        A new customer profile will be created using <strong>@Model.LeadName</strong>'s contact details.
                    </div>
                </div>

                <div class="form-check">
                    <input class="form-check-input" type="radio" name="customerMode" id="modeExistingCustomer" value="existing"
                           checked="@(Model.ExistingCustomerId.HasValue)">
                    <label class="form-check-label fw-semibold" for="modeExistingCustomer">
                        Link to an existing customer
                    </label>
                    <div class="form-text text-muted small ms-4">
                        Associate this converted lead with an existing account in your database.
                    </div>
                </div>
            </div>

            <!-- Existing Customer Search Container -->
            <div id="existingCustomerSection" class="@(Model.ExistingCustomerId.HasValue ? "" : "d-none") p-3 bg-light rounded border mb-2">
                <label for="customerLookupInput" class="form-label small fw-semibold">Select Customer <span class="text-danger">*</span></label>
                <input type="hidden" asp-for="ExistingCustomerId" id="existingCustomerIdInput" />
                <input type="hidden" asp-for="ExistingCustomerLabel" id="existingCustomerLabelInput" />

                <div class="position-relative">
                    <input type="text" id="customerLookupInput" class="form-control"
                           placeholder="Type to search customer by name, email, or code..."
                           value="@Model.ExistingCustomerLabel" autocomplete="off" />
                    <div id="lookupResults" class="dropdown-menu w-100 shadow-sm mt-1" style="max-height: 200px; overflow-y: auto;"></div>
                </div>
                <span asp-validation-for="ExistingCustomerId" class="text-danger small d-block mt-1"></span>

                <div id="selectedCustomerDisplay" class="@(Model.ExistingCustomerId.HasValue ? "" : "d-none") mt-2 text-success small fw-semibold">
                    <i class="bi bi-check-circle me-1"></i> Selected: <span id="selectedCustomerName">@Model.ExistingCustomerLabel</span>
                    <button type="button" class="btn btn-sm btn-link text-danger p-0 ms-2 text-decoration-none" id="clearSelectedCustomer">Clear</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Opportunity Section Card -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white py-3">
            <h6 class="m-0 fw-semibold">Opportunity</h6>
        </div>
        <div class="card-body">
            @if (Model.IsOpportunityAvailable)
            {
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" asp-for="CreateOpportunity" id="createOpportunityCheck" />
                    <label class="form-check-label fw-semibold" for="createOpportunityCheck">
                        Create an opportunity for this deal
                    </label>
                </div>

                <div id="opportunityFieldsContainer" class="@(Model.CreateOpportunity ? "" : "d-none")">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="OpportunityName" class="form-label small fw-semibold">Opportunity title <span class="text-danger">*</span></label>
                            <input asp-for="OpportunityName" class="form-control" id="oppNameInput" />
                            <span asp-validation-for="OpportunityName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="OpportunityAmount" class="form-label small fw-semibold">Estimated value (₹) <span class="text-danger">*</span></label>
                            <input asp-for="OpportunityAmount" type="number" step="0.01" min="0" class="form-control" id="oppAmountInput" />
                            <span asp-validation-for="OpportunityAmount" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="OpportunityProbability" class="form-label small fw-semibold">Probability (%)</label>
                            <input asp-for="OpportunityProbability" type="number" min="0" max="100" class="form-control" />
                            <span asp-validation-for="OpportunityProbability" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="OpportunityExpectedCloseDate" class="form-label small fw-semibold">Expected close date <span class="text-danger">*</span></label>
                            <input asp-for="OpportunityExpectedCloseDate" type="date" class="form-control" id="oppCloseDateInput" />
                            <span asp-validation-for="OpportunityExpectedCloseDate" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="OpportunityNotes" class="form-label small fw-semibold">Opportunity notes</label>
                            <textarea asp-for="OpportunityNotes" rows="3" class="form-control" placeholder="Key customer expectations, requirements, or next steps..."></textarea>
                            <span asp-validation-for="OpportunityNotes" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="text-muted small">
                    <i class="bi bi-info-circle me-1"></i>
                    The opportunity pipeline module will be integrated in the upcoming release. Converting this lead will create the customer account directly.
                </div>
            }
        </div>
    </div>

    <!-- Form Actions -->
    <div class="d-flex align-items-center gap-2 mb-5">
        <button type="submit" class="btn btn-primary" id="submitConvertBtn">
            Convert lead
        </button>
        <a asp-action="Details" asp-route-id="@Model.LeadId" class="btn btn-outline-secondary">
            Cancel
        </a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/leads.js"></script>
}
