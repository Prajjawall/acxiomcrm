@model AcxiomCrm.Web.ViewModels.Leads.LeadFormViewModel
@using AcxiomCrm.Domain.Enums
@using AcxiomCrm.Web.Presentation

<input type="hidden" asp-for="Id" />
<input type="hidden" asp-for="RowVersion" />

@if (!ViewData.ModelState.IsValid && ViewData.ModelState.ContainsKey(string.Empty) && ViewData.ModelState[string.Empty]!.Errors.Count > 0)
{
    <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
        <div>
            @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
            {
                <div>@error.ErrorMessage</div>
            }
            @if (Model.Id > 0)
            {
                <div class="mt-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="alert-link">Reload current data</a>
                </div>
            }
        </div>
    </div>
}

<!-- Contact Information -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white py-3">
        <h6 class="m-0 fw-semibold">Lead Details</h6>
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Name" class="form-label small fw-semibold">Lead name <span class="text-danger">*</span></label>
                <input asp-for="Name" class="form-control" placeholder="Contact person name" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="CompanyName" class="form-label small fw-semibold">Company name</label>
                <input asp-for="CompanyName" class="form-control" placeholder="Company or organization" />
                <span asp-validation-for="CompanyName" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Email" class="form-label small fw-semibold">Email address <span class="text-danger">*</span></label>
                <input asp-for="Email" type="email" class="form-control" placeholder="name@company.com" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Phone" class="form-label small fw-semibold">Phone number <span class="text-danger">*</span></label>
                <input asp-for="Phone" class="form-control" placeholder="10-digit mobile number" />
                <span asp-validation-for="Phone" class="text-danger small"></span>
            </div>
        </div>
    </div>
</div>

<!-- Qualification & Sourcing -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white py-3">
        <h6 class="m-0 fw-semibold">Source &amp; Valuation</h6>
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="Source" class="form-label small fw-semibold">Lead source <span class="text-danger">*</span></label>
                <select asp-for="Source" class="form-select">
                    @foreach (var s in Enum.GetValues<LeadSource>())
                    {
                        <option value="@s">@Labels.For(s)</option>
                    }
                </select>
                <span asp-validation-for="Source" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Priority" class="form-label small fw-semibold">Priority <span class="text-danger">*</span></label>
                <select asp-for="Priority" class="form-select">
                    @foreach (var p in Enum.GetValues<LeadPriority>())
                    {
                        <option value="@p">@Labels.For(p)</option>
                    }
                </select>
                <span asp-validation-for="Priority" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="ExpectedValue" class="form-label small fw-semibold">Expected value (₹)</label>
                <input asp-for="ExpectedValue" type="number" step="0.01" min="0" class="form-control" placeholder="Estimated deal value" />
                <span asp-validation-for="ExpectedValue" class="text-danger small"></span>
            </div>

            @if (Model.OwnerOptions.Count > 0)
            {
                <div class="col-md-6">
                    <label asp-for="OwnerId" class="form-label small fw-semibold">Assigned owner</label>
                    <select asp-for="OwnerId" class="form-select">
                        <option value="">Select owner...</option>
                        @foreach (var owner in Model.OwnerOptions)
                        {
                            <option value="@owner.Id" selected="@(Model.OwnerId == owner.Id)">@owner.Name (@owner.Role)</option>
                        }
                    </select>
                    <span asp-validation-for="OwnerId" class="text-danger small"></span>
                </div>
            }
        </div>
    </div>
</div>
