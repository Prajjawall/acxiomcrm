@model AcxiomCrm.Web.ViewModels.Leads.LeadListViewModel
@using AcxiomCrm.Domain.Enums
@using AcxiomCrm.Web.Presentation

@{
    ViewData["Title"] = "Leads";
    ViewData["Page"] = "leads";

    var isFiltered = !string.IsNullOrWhiteSpace(Model.Filter.Search)
        || Model.Filter.Status.HasValue
        || Model.Filter.Priority.HasValue
        || Model.Filter.Source.HasValue
        || !string.IsNullOrWhiteSpace(Model.Filter.OwnerId);

    var pagerQuery = new Dictionary<string, string?>(StringComparer.OrdinalIgnoreCase);
    if (!string.IsNullOrWhiteSpace(Model.Filter.Search)) pagerQuery["search"] = Model.Filter.Search;
    if (Model.Filter.Status.HasValue) pagerQuery["status"] = Model.Filter.Status.Value.ToString();
    if (Model.Filter.Priority.HasValue) pagerQuery["priority"] = Model.Filter.Priority.Value.ToString();
    if (Model.Filter.Source.HasValue) pagerQuery["source"] = Model.Filter.Source.Value.ToString();
    if (!string.IsNullOrWhiteSpace(Model.Filter.OwnerId)) pagerQuery["ownerId"] = Model.Filter.OwnerId;
    if (Model.PageQuery.PageSize != 20) pagerQuery["pageSize"] = Model.PageQuery.PageSize.ToString();
    if (!string.IsNullOrWhiteSpace(Model.PageQuery.Sort)) pagerQuery["sort"] = Model.PageQuery.Sort;
    if (Model.PageQuery.Desc) pagerQuery["desc"] = "true";

    var pagerModel = new PagerModel(
        Model.Result.Page,
        Model.Result.PageSize,
        Model.Result.Total,
        "Index",
        pagerQuery);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Leads</h1>
        <p class="text-muted small mb-0">Track prospective buyers, qualification stages, and conversion to customers.</p>
    </div>
    @if (Model.CanCreate)
    {
        <a asp-action="Create" class="btn btn-primary" id="createLeadButton">
            Create lead
        </a>
    }
</div>

<!-- Filter Bar -->
<div class="card mb-4 border-0 shadow-sm">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" id="leadFilterForm" class="row g-2 align-items-center">
            <div class="col-md-3">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-transparent text-muted"><i class="bi bi-search"></i>Search</span>
                    <input type="text" name="search" id="leadSearchInput" class="form-control"
                           placeholder="Search code, name, company, email, phone..." value="@Model.Filter.Search" />
                </div>
            </div>

            <div class="col-md-2">
                <select name="status" class="form-select form-select-sm" id="leadStatusSelect">
                    <option value="">All Statuses</option>
                    @foreach (var s in Enum.GetValues<LeadStatus>())
                    {
                        <option value="@s" selected="@(Model.Filter.Status == s)">@Labels.For(s)</option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <select name="priority" class="form-select form-select-sm" id="leadPrioritySelect">
                    <option value="">All Priorities</option>
                    @foreach (var p in Enum.GetValues<LeadPriority>())
                    {
                        <option value="@p" selected="@(Model.Filter.Priority == p)">@Labels.For(p)</option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <select name="source" class="form-select form-select-sm" id="leadSourceSelect">
                    <option value="">All Sources</option>
                    @foreach (var src in Enum.GetValues<LeadSource>())
                    {
                        <option value="@src" selected="@(Model.Filter.Source == src)">@Labels.For(src)</option>
                    }
                </select>
            </div>

            @if (Model.OwnerOptions.Count > 0)
            {
                <div class="col-md-2">
                    <select name="ownerId" class="form-select form-select-sm" id="leadOwnerSelect">
                        <option value="">All Owners</option>
                        @foreach (var owner in Model.OwnerOptions)
                        {
                            <option value="@owner.Id" selected="@(Model.Filter.OwnerId == owner.Id)">@owner.Name (@owner.Role)</option>
                        }
                    </select>
                </div>
            }

            <div class="col-auto d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary">Filter</button>
                @if (isFiltered)
                {
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Clear</a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Leads Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        @if (Model.Result.Items.Count > 0)
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="leadsTable">
                    <thead class="table-light text-muted small text-uppercase">
                        <tr>
                            <th scope="col" style="width: 140px;">Code</th>
                            <th scope="col">Lead</th>
                            <th scope="col">Email</th>
                            <th scope="col">Phone</th>
                            <th scope="col">Source</th>
                            <th scope="col">Status</th>
                            <th scope="col">Priority</th>
                            <th scope="col" class="text-end">Expected Value</th>
                            <th scope="col">Owner</th>
                            <th scope="col">Created</th>
                            <th scope="col" class="text-end" style="width: 100px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Result.Items)
                        {
                            <tr id="lead-row-@item.Id">
                                <td>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="ax-code text-decoration-none">
                                        @item.Code
                                    </a>
                                </td>
                                <td>
                                    <div class="fw-semibold">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="text-dark text-decoration-none">
                                            @item.Name
                                        </a>
                                    </div>
                                    @if (!string.IsNullOrEmpty(item.CompanyName))
                                    {
                                        <div class="text-muted small">@item.CompanyName</div>
                                    }
                                </td>
                                <td>
                                    <a href="mailto:@item.Email" class="text-muted text-decoration-none small">@item.Email</a>
                                </td>
                                <td class="small">
                                    <a href="tel:@item.Phone" class="text-muted text-decoration-none">@item.Phone</a>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@Labels.For(item.Source)</span>
                                </td>
                                <td>
                                    <partial name="_StatusBadge" model='StatusBadges.For("Lead", item.Status)' />
                                </td>
                                <td>
                                    <partial name="_StatusBadge" model='StatusBadges.For("Lead", item.Priority)' />
                                </td>
                                <td class="ax-num text-end fw-medium">
                                    @Formatters.Money(item.ExpectedValue)
                                </td>
                                <td>
                                    <span class="small fw-medium">@item.OwnerName</span>
                                </td>
                                <td class="text-muted small">
                                    @item.CreatedDate.ToString("yyyy-MM-dd")
                                </td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary" title="View details">
                                        View
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <div class="p-3 border-top">
                <partial name="_Pager" model="pagerModel" />
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <div class="text-muted mb-3">
                    <i class="bi bi-inbox fs-1"></i>
                </div>
                @if (isFiltered)
                {
                    <h5 class="fw-semibold">No leads match these filters</h5>
                    <p class="text-muted small mb-3">Try adjusting or clearing your search criteria.</p>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Clear filters</a>
                }
                else
                {
                    <h5 class="fw-semibold">No leads found</h5>
                    <p class="text-muted small mb-3">Get started by creating your first sales lead.</p>
                    @if (Model.CanCreate)
                    {
                        <a asp-action="Create" class="btn btn-sm btn-primary">Create lead</a>
                    }
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/leads.js"></script>
}
