@model AcxiomCrm.Web.ViewModels.Leads.LeadDetailsViewModel
@using AcxiomCrm.Domain.Enums
@using AcxiomCrm.Web.Presentation

@{
    ViewData["Title"] = Model.Lead.Name;
    ViewData["Page"] = "leads";
    var isTerminal = Model.Lead.Status is LeadStatus.Converted or LeadStatus.Lost;
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <a asp-action="Index" class="btn btn-sm btn-link text-decoration-none px-0 mb-2">
            &larr; Back to leads
        </a>
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <h1 class="h3 mb-0">@Model.Lead.Name</h1>
            <span class="font-monospace text-muted small bg-light px-2 py-1 rounded border">@Model.Lead.Code</span>
            <partial name="_StatusBadge" model='StatusBadges.For("Lead", Model.Lead.Status)' />
            <partial name="_StatusBadge" model='StatusBadges.For("Lead", Model.Lead.Priority)' />
        </div>
        @if (!string.IsNullOrEmpty(Model.Lead.CompanyName))
        {
            <p class="text-muted small mt-1 mb-0">@Model.Lead.CompanyName</p>
        }
    </div>

    <div class="d-flex align-items-center gap-2 flex-wrap">
        <partial name="_StatusActions" model="Model" />

        @if (Model.CanAssign && Model.AssignableOwners.Count > 0 && !isTerminal)
        {
            <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#assignModal" id="assignLeadBtn">
                Assign
            </button>
        }

        @if (Model.CanEdit && !isTerminal)
        {
            <a asp-action="Edit" asp-route-id="@Model.Lead.Id" class="btn btn-outline-primary btn-sm" id="editLeadBtn">
                Edit
            </a>
        }

        @if (Model.CanDelete)
        {
            <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#deleteModal" id="deleteLeadBtn">
                Delete
            </button>
        }
    </div>
</div>

<div class="row g-4">
    <!-- Left Column: Lead Facts -->
    <div class="col-lg-4">
        <!-- Lead Facts Card -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white py-3">
                <h6 class="m-0 fw-semibold">Lead Facts</h6>
            </div>
            <div class="card-body">
                <dl class="row mb-0 small">
                    <dt class="col-sm-5 text-muted">Lead Code</dt>
                    <dd class="col-sm-7 font-monospace fw-semibold">@Model.Lead.Code</dd>

                    <dt class="col-sm-5 text-muted">Status</dt>
                    <dd class="col-sm-7">
                        <partial name="_StatusBadge" model='StatusBadges.For("Lead", Model.Lead.Status)' />
                    </dd>

                    <dt class="col-sm-5 text-muted">Priority</dt>
                    <dd class="col-sm-7">
                        <partial name="_StatusBadge" model='StatusBadges.For("Lead", Model.Lead.Priority)' />
                    </dd>

                    <dt class="col-sm-5 text-muted">Source</dt>
                    <dd class="col-sm-7">@Labels.For(Model.Lead.Source)</dd>

                    <dt class="col-sm-5 text-muted">Expected Value</dt>
                    <dd class="col-sm-7 ax-num fw-semibold">
                        @Formatters.Money(Model.Lead.ExpectedValue)
                    </dd>

                    <dt class="col-sm-5 text-muted">Owner</dt>
                    <dd class="col-sm-7 fw-medium">@Model.Lead.OwnerName</dd>

                    <dt class="col-sm-5 text-muted">Email</dt>
                    <dd class="col-sm-7"><a href="mailto:@Model.Lead.Email" class="text-decoration-none">@Model.Lead.Email</a></dd>

                    <dt class="col-sm-5 text-muted">Phone</dt>
                    <dd class="col-sm-7"><a href="tel:@Model.Lead.Phone" class="text-decoration-none">@Model.Lead.Phone</a></dd>

                    @if (!string.IsNullOrEmpty(Model.Lead.CompanyName))
                    {
                        <dt class="col-sm-5 text-muted">Company</dt>
                        <dd class="col-sm-7">@Model.Lead.CompanyName</dd>
                    }

                    <dt class="col-sm-5 text-muted">Created</dt>
                    <dd class="col-sm-7 text-muted">@Model.Lead.CreatedDate.ToString("yyyy-MM-dd HH:mm")</dd>

                    @if (Model.Lead.ModifiedDate.HasValue)
                    {
                        <dt class="col-sm-5 text-muted">Modified</dt>
                        <dd class="col-sm-7 text-muted">@Model.Lead.ModifiedDate.Value.ToString("yyyy-MM-dd HH:mm")</dd>
                    }
                </dl>
            </div>
        </div>

        <!-- Converted Information Card -->
        @if (Model.Lead.Status == LeadStatus.Converted && Model.Lead.ConvertedCustomerId.HasValue)
        {
            <div class="card border-0 shadow-sm mb-4 border-start border-4 border-success">
                <div class="card-header bg-white py-3">
                    <h6 class="m-0 fw-semibold text-success">
                        <i class="bi bi-check-circle-fill me-1"></i> Converted Account
                    </h6>
                </div>
                <div class="card-body">
                    <dl class="row mb-0 small">
                        <dt class="col-sm-5 text-muted">Customer</dt>
                        <dd class="col-sm-7 fw-semibold">
                            <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.Lead.ConvertedCustomerId.Value" class="text-decoration-none">
                                @(Model.Lead.ConvertedCustomerName ?? $"Customer #{Model.Lead.ConvertedCustomerId.Value}")
                            </a>
                        </dd>

                        @if (Model.Lead.ConvertedOpportunityId.HasValue)
                        {
                            <dt class="col-sm-5 text-muted">Opportunity</dt>
                            <dd class="col-sm-7">
                                Opportunity #@Model.Lead.ConvertedOpportunityId.Value
                            </dd>
                        }

                        @if (Model.Lead.ConvertedDate.HasValue)
                        {
                            <dt class="col-sm-5 text-muted">Converted on</dt>
                            <dd class="col-sm-7 text-muted">@Model.Lead.ConvertedDate.Value.ToString("yyyy-MM-dd HH:mm")</dd>
                        }
                    </dl>
                </div>
            </div>
        }
    </div>

    <!-- Right Column: Tabs (Audit Trail) -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom-0 pb-0">
                <ul class="nav nav-tabs card-header-tabs" role="tablist">
                    <li class="nav-item">
                        <button class="nav-link active fw-semibold" id="history-tab" data-bs-toggle="tab" data-bs-target="#history-pane" type="button" role="tab">
                            History
                        </button>
                    </li>
                </ul>
            </div>
            <div class="card-body">
                <div class="tab-content">
                    <div class="tab-pane fade show active" id="history-pane" role="tabpanel">
                        @if (Model.AuditHistory.Count > 0)
                        {
                            <div class="table-responsive">
                                <table class="table table-sm table-hover align-middle mb-0">
                                    <thead class="table-light text-muted small text-uppercase">
                                        <tr>
                                            <th scope="col" style="width: 160px;">Date &amp; Time</th>
                                            <th scope="col" style="width: 120px;">User</th>
                                            <th scope="col" style="width: 130px;">Action</th>
                                            <th scope="col" style="width: 90px;">Result</th>
                                            <th scope="col">IP Address</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var log in Model.AuditHistory)
                                        {
                                            <tr>
                                                <td class="text-nowrap small text-muted">@log.CreatedDateUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                                <td class="fw-medium small">@log.UserName</td>
                                                <td>
                                                    <span class="badge bg-light text-dark border">@log.Action</span>
                                                </td>
                                                <td>
                                                    <span class="badge @(log.Result == AcxiomCrm.Domain.Enums.AuditResult.Success ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger")">
                                                        @log.Result
                                                    </span>
                                                </td>
                                                <td class="small text-muted font-monospace">@log.IpAddress</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted small py-4 text-center mb-0">No audit log entries recorded for this lead.</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Assign Modal -->
@if (Model.CanAssign && Model.AssignableOwners.Count > 0 && !isTerminal)
{
    <div class="modal fade" id="assignModal" tabindex="-1" aria-labelledby="assignModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form asp-action="Assign" asp-route-id="@Model.Lead.Id" method="post">
                    <input type="hidden" name="RowVersion" value="@(Model.Lead.RowVersion.Length > 0 ? Convert.ToBase64String(Model.Lead.RowVersion) : "")" />
                    <div class="modal-header">
                        <h5 class="modal-title" id="assignModalLabel">Assign Lead</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p class="small text-muted mb-3">Reassign <strong>@Model.Lead.Name</strong> to a different sales team member.</p>
                        <div class="mb-3">
                            <label for="assignOwnerSelect" class="form-label small fw-semibold">New owner</label>
                            <select name="OwnerId" id="assignOwnerSelect" class="form-select" required>
                                <option value="">Select owner...</option>
                                @foreach (var owner in Model.AssignableOwners)
                                {
                                    <option value="@owner.Id" selected="@(Model.Lead.OwnerId == owner.Id)">@owner.Name (@owner.Role)</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-sm btn-primary">Assign lead</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation Modal -->
@if (Model.CanDelete)
{
    <div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteModalLabel">Confirm Delete</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    Are you sure you want to delete lead <strong>@Model.Lead.Name</strong> (@Model.Lead.Code)?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <form asp-action="Delete" asp-route-id="@Model.Lead.Id" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-danger" id="confirmDeleteLeadBtn">Delete lead</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
