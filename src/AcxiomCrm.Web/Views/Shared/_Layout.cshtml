<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} · AcxiomCRM" : "AcxiomCRM")</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body data-page="@ViewData["Page"]">
    <a href="#main" class="ax-visually-hidden focus-visible position-absolute p-2 bg-primary text-white z-3">Skip to main content</a>

    <div class="app-shell">
        <partial name="_Sidebar" />

        <div class="app-main-area">
            <header class="app-topbar">
                <div class="d-flex align-items-center gap-2">
                    <h5 class="m-0 fw-semibold text-truncate">@ViewData["Title"]</h5>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <partial name="_UserMenu" />
                </div>
            </header>

            <main id="main" class="app-content" role="main">
                <partial name="_FlashAlerts" />
                @RenderBody()
            </main>

            <footer class="app-footer text-muted d-flex justify-content-between align-items-center">
                <span>AcxiomCRM &copy; 2026</span>
                <span>Role-based Enterprise CRM</span>
            </footer>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
